        "psr-4": {
            "Obii\\Slug\\": "src"
        }
    },
    "require": {
        "obii/platform": "*@dev"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Obii\\Slug\\Providers\\SlugServiceProvider"
            ],
